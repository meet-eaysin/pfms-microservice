generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Contact {
  id           String      @id @default(uuid()) @db.Uuid
  userId       String      @db.Uuid
  contactType  String      // app_user, external
  linkedUserId String?     @db.Uuid
  name         String?
  phone        String?
  email        String?
  address      String?
  relationship String?
  notes        String?
  isFavorite   Boolean     @default(false)
  isBlocked    Boolean     @default(false)
  loans        Loan[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@map("contacts")
}

enum LoanType {
  BORROWED
  LENT
}

enum LoanStatus {
  ACTIVE
  PAID
  OVERDUE
  CANCELLED
  DEFAULTED
}

enum InterestType {
  SIMPLE
  COMPOUND
  NONE
}

model Loan {
  id                String         @id @default(uuid()) @db.Uuid
  userId            String         @db.Uuid
  contactId         String         @db.Uuid
  contact           Contact        @relation(fields: [contactId], references: [id])
  type              LoanType
  principalAmount   Decimal        @db.Decimal(12, 2)
  currency          String         @default("USD") @db.Char(3)
  interestRate      Decimal?       @db.Decimal(5, 2)
  interestType      InterestType   @default(NONE)
  startDate         DateTime
  endDate           DateTime?
  emiEnabled        Boolean        @default(false)
  emiFrequency      String?        // monthly, weekly, daily
  emiAmount         Decimal?       @db.Decimal(12, 2)
  status            LoanStatus     @default(ACTIVE)
  totalPaid         Decimal        @default(0) @db.Decimal(12, 2)
  reason            String?
  category          String?
  emiSchedules     EMISchedule[]
  payments          Payment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([userId])
  @@index([contactId])
  @@map("loans")
}

enum ScheduleStatus {
  PENDING
  PAID
  PARTIAL
  OVERDUE
  SKIPPED
  WAIVED
}

model EMISchedule {
  id                String         @id @default(uuid()) @db.Uuid
  loanId            String         @db.Uuid
  loan              Loan           @relation(fields: [loanId], references: [id])
  installmentNumber Int
  dueDate           DateTime
  principalAmount   Decimal        @db.Decimal(12, 2)
  interestAmount    Decimal?       @db.Decimal(12, 2)
  totalAmount       Decimal        @db.Decimal(12, 2)
  status            ScheduleStatus @default(PENDING)
  paidAmount        Decimal        @default(0) @db.Decimal(12, 2)
  payments          Payment[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@index([loanId])
  @@map("emi_schedules")
}

model Payment {
  id             String       @id @default(uuid()) @db.Uuid
  loanId         String       @db.Uuid
  loan           Loan         @relation(fields: [loanId], references: [id])
  emiScheduleId  String?      @db.Uuid
  emiSchedule    EMISchedule? @relation(fields: [emiScheduleId], references: [id])
  userId         String       @db.Uuid
  amount         Decimal      @db.Decimal(12, 2)
  currency       String       @default("USD") @db.Char(3)
  paymentDate    DateTime
  paymentMethod  String?
  reference      String?
  status         String       @default("COMPLETED") // COMPLETED, PENDING, FAILED
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([userId])
  @@index([loanId])
  @@map("payments")
}
